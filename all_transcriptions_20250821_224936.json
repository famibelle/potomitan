[
  {
    "file": "ae6a87a8_vocals.mp3_segment_99104_103744.mp3",
    "transcription": " E pon dote moun ki ou menm peke peote piee ou a dan pe pepala yo pri la.",
    "timestamp": "2025-08-21T20:49:38.382278",
    "author": "whisper-large-v3",
    "created_at": "2025-08-21T22:49:27.217649"
  },
  {
    "file": "ae6a87a8_vocals.mp3_segment_65978_68712.mp3",
    "transcription": " Usi niopan ike menpupi sipotisa",
    "timestamp": "2025-08-21T20:49:38.753370",
    "author": "whisper-large-v3",
    "created_at": "2025-08-21T22:49:25.832556"
  },
  {
    "file": "ae6a87a8_vocals.mp3_segment_16821_22221.mp3",
    "transcription": " Asi dis la sa, an ni men plas k an teni la te ka jowe foutbol jvente santa nou. Gaudien.",
    "timestamp": "2025-08-21T20:49:39.271064",
    "author": "whisper-large-v3",
    "created_at": "2025-08-21T22:49:23.767419"
  },
  {
    "file": "ae6a87a8_vocals.mp3_segment_71142_73892.mp3",
    "transcription": " Men la balas d'abaw, trope topok an le tete.",
    "timestamp": "2025-08-21T20:49:39.668649",
    "author": "whisper-large-v3",
    "created_at": "2025-08-21T22:49:26.167579"
  },
  {
    "file": "ae6a87a8_vocals.mp3_segment_9160_12990.mp3",
    "transcription": " An kandida si l'isla yo ka kriye nou pou eleksyon rejonal la sa.",
    "timestamp": "2025-08-21T20:49:40.111664",
    "author": "whisper-large-v3",
    "created_at": "2025-08-21T22:49:23.519403"
  },
  {
    "file": "ae6a87a8_vocals.mp3_segment_38100_40260.mp3",
    "transcription": " Fasano adon sel con",
    "timestamp": "2025-08-21T20:49:40.439994",
    "author": "whisper-large-v3",
    "created_at": "2025-08-21T22:49:24.155445"
  },
  {
    "file": "ae6a87a8_vocals.mp3_segment_4114_6561.mp3",
    "transcription": " Anseyon a otis, mizisyen, chante, gwa louveyen.",
    "timestamp": "2025-08-21T20:49:40.858000",
    "author": "whisper-large-v3",
    "created_at": "2025-08-21T22:49:23.393394"
  },
  {
    "file": "ae6a87a8_vocals.mp3_segment_13682_15758.mp3",
    "transcription": " Noua kapiten anunsi, hwnnade selbono.",
    "timestamp": "2025-08-21T20:49:41.245103",
    "author": "whisper-large-v3",
    "created_at": "2025-08-21T22:49:23.636410"
  },
  {
    "file": "ae6a87a8_vocals.mp3_segment_82667_84912.mp3",
    "transcription": " C'est d'avoir sa sa vie ou toujours sa vie à véo.",
    "timestamp": "2025-08-21T20:49:41.639088",
    "author": "whisper-large-v3",
    "created_at": "2025-08-21T22:49:26.521602"
  },
  {
    "file": "ae6a87a8_vocals.mp3_segment_27233_37139.mp3",
    "transcription": " Kapiten an nou di ke fono met poezi adan misyon nou. Alos, mi deti mou make a yon de se chal tounen nou la ki ka gidone eklerishimen nou. Mise Soni Rupert.",
    "timestamp": "2025-08-21T20:49:42.321607",
    "author": "whisper-large-v3",
    "created_at": "2025-08-21T22:49:24.037437"
  },
  {
    "file": "ae6a87a8_vocals.mp3_segment_23132_26541.mp3",
    "transcription": " Gaudien l'espi la, se gaudien l'espi la ki ka vide nou la.",
    "timestamp": "2025-08-21T20:49:42.761013",
    "author": "whisper-large-v3",
    "created_at": "2025-08-21T22:49:23.890427"
  },
  {
    "file": "ae6a87a8_vocals.mp3_segment_1482_3659.mp3",
    "transcription": " Yela la fami, Asi Dominicoko.",
    "timestamp": "2025-08-21T20:49:43.121227",
    "author": "whisper-large-v3",
    "created_at": "2025-08-21T22:49:23.274386"
  },
  {
    "file": "ae6a87a8_vocals.mp3_segment_74331_79208.mp3",
    "transcription": " Zoko be la solej alante trop an cheyaw, Puyo pedi ke ou panifye li pou aj.",
    "timestamp": "2025-08-21T20:49:43.606736",
    "author": "whisper-large-v3",
    "created_at": "2025-08-21T22:49:26.296587"
  },
  {
    "file": "ae6a87a8_vocals.mp3_segment_85857_89451.mp3",
    "transcription": " Se kop lestomak yon fe an leyo, ki fe ou an jan baddeye?",
    "timestamp": "2025-08-21T20:49:44.034081",
    "author": "whisper-large-v3",
    "created_at": "2025-08-21T22:49:26.645611"
  }
]